"""
FlashHead 数字人推流服务（MP4 分段版，严格按照 gradio_app_streaming.py 实现方式）

接口：
  GET  /health                  健康检查
  GET  /ws/{client_id}          WebSocket 推流端点（发送 MP4 分段）
  POST /push_audio/{client_id}  接收 TTS 音频（int16 PCM, 24kHz）
  POST /flush/{client_id}       TTS 发送完毕，刷新剩余帧为最后一段 MP4
  POST /interrupt/{client_id}   打断当前会话推理

WebSocket 帧格式（binary）：
  第 1 字节：消息类型
    0x04 = MP4 分段帧
           格式：[1B type=0x04][4B mp4_len little-endian][MP4 bytes]
"""

import asyncio
import concurrent.futures
import logging
import os
import struct
import subprocess
import sys
import tempfile
import wave
from collections import deque
from contextlib import asynccontextmanager
from typing import Dict, List, Optional

import imageio
import numpy as np
import soxr
from fastapi import FastAPI, WebSocket, WebSocketDisconnect, Request
from fastapi.responses import JSONResponse

CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
FLASHHEAD_ROOT = os.path.abspath(os.path.join(CURRENT_DIR, ".."))
if FLASHHEAD_ROOT not in sys.path:
    sys.path.insert(0, FLASHHEAD_ROOT)

from flash_head.inference import (
    get_audio_embedding,
    get_base_data,
    get_infer_params,
    get_pipeline,
    run_pipeline,
)

logging.basicConfig(
    level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s"
)
logger = logging.getLogger(__name__)

_pipeline = None
_infer_params: dict = {}
_cfg: Optional["ServerConfig"] = None
_inference_lock = asyncio.Lock()

# 分段策略：首段保持较短以降低首帧等待，后续段加长以减少段间切换卡顿
FIRST_SEGMENT_CHUNKS = int(os.getenv("FLASHHEAD_FIRST_SEGMENT_CHUNKS", "3"))
STEADY_SEGMENT_CHUNKS = int(os.getenv("FLASHHEAD_STEADY_SEGMENT_CHUNKS", "5"))
# 输出视频帧率（用户要求 16fps，低于模型原生 25fps，需对帧进行下采样）
OUTPUT_FPS = int(os.getenv("FLASHHEAD_OUTPUT_FPS", "16"))
# 编码输出最大边（0 表示不缩放；建议 lite 模型设为 384）
OUTPUT_MAX_EDGE = int(os.getenv("FLASHHEAD_OUTPUT_MAX_EDGE", "0"))
# x264 编码参数（影响码率与解码压力）
ENCODE_PRESET = os.getenv("FLASHHEAD_ENCODE_PRESET", "veryfast")
ENCODE_CRF = int(os.getenv("FLASHHEAD_ENCODE_CRF", "30"))

# flush 哨兵：放入 _audio_in_queue 表示 TTS 已结束
_FLUSH_SENTINEL = object()


# ══════════════════════════════════════════════════════════════════════════════
# 配置
# ══════════════════════════════════════════════════════════════════════════════

class ServerConfig:
    def __init__(
        self,
        ckpt_dir: str,
        wav2vec_dir: str,
        model_type: str,
        cond_image: str,
        device: str = "cuda:0",
        base_seed: int = 42,
        use_face_crop: bool = False,
    ):
        self.ckpt_dir = ckpt_dir
        self.wav2vec_dir = wav2vec_dir
        self.model_type = model_type
        self.cond_image = cond_image
        self.device = device
        self.base_seed = base_seed
        self.use_face_crop = use_face_crop


# ══════════════════════════════════════════════════════════════════════════════
# 工具函数（参照 gradio_app_streaming.py）
# ══════════════════════════════════════════════════════════════════════════════

def _write_frames_to_mp4(chunks_np_list: List[np.ndarray], video_path: str, fps: int):
    """将帧列表（list of np arrays，每个形状 (N, H, W, 3)）写入 MP4（仅视频轨）。"""
    os.makedirs(os.path.dirname(video_path) or ".", exist_ok=True)
    with imageio.get_writer(
        video_path,
        format="mp4",
        mode="I",
        fps=fps,
        codec="h264",
        ffmpeg_params=[
            "-bf", "0",
            "-preset", ENCODE_PRESET,
            "-tune", "zerolatency",
            "-crf", str(ENCODE_CRF),
            "-pix_fmt", "yuv420p",
        ],
    ) as writer:
        for chunk_np in chunks_np_list:
            for i in range(chunk_np.shape[0]):
                writer.append_data(chunk_np[i])


def _save_audio_to_wav(pcm_int16_bytes: bytes, wav_path: str, sample_rate: int = 24000):
    """将 int16 PCM 字节写入 WAV 文件。"""
    os.makedirs(os.path.dirname(wav_path) or ".", exist_ok=True)
    with wave.open(wav_path, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(sample_rate)
        wf.writeframes(pcm_int16_bytes)


def _subsample_frames(frames_np: np.ndarray, orig_fps: int, target_fps: int) -> np.ndarray:
    """从原始帧率下采样到目标帧率，保持视频时长不变。"""
    if orig_fps == target_fps:
        return frames_np
    total = frames_np.shape[0]
    target_count = max(1, int(round(total * target_fps / orig_fps)))
    indices = np.linspace(0, total - 1, target_count).astype(int)
    return frames_np[indices]


def _downscale_frames(frames_np: np.ndarray, max_edge: int) -> np.ndarray:
    """按最长边等比下采样，减少编码体积和前端解码压力。"""
    if max_edge <= 0:
        return frames_np
    if frames_np.ndim != 4:
        return frames_np

    _, h, w, _ = frames_np.shape
    cur_max = max(h, w)
    if cur_max <= max_edge:
        return frames_np

    scale = max_edge / float(cur_max)
    new_h = max(2, int(round(h * scale)))
    new_w = max(2, int(round(w * scale)))
    if new_h % 2 == 1:
        new_h -= 1
    if new_w % 2 == 1:
        new_w -= 1

    y_idx = np.linspace(0, h - 1, new_h).astype(int)
    x_idx = np.linspace(0, w - 1, new_w).astype(int)
    return frames_np[:, y_idx][:, :, x_idx]


def _encode_segment(
    frame_chunks: List[np.ndarray],
    audio_24k_chunks: List[bytes],
    fps: int,
    client_id: str,
    segment_id: int,
) -> Optional[bytes]:
    """
    将帧列表和 24kHz int16 音频编码为 MP4 文件并返回字节。
    在线程池中执行，避免阻塞事件循环。
    与 gradio_app_streaming.py 的 save_video_with_audio() 逻辑一致。
    """
    audio_bytes = b"".join(audio_24k_chunks)

    with tempfile.TemporaryDirectory(prefix=f"fh_{client_id}_s{segment_id}_") as tmpdir:
        temp_video = os.path.join(tmpdir, "video.mp4")
        temp_audio = os.path.join(tmpdir, "audio.wav")
        out_mp4 = os.path.join(tmpdir, "out.mp4")

        # 写入视频（仅视频轨）
        _write_frames_to_mp4(frame_chunks, temp_video, fps)

        # 写入音频 WAV（24kHz int16）
        _save_audio_to_wav(audio_bytes, temp_audio, sample_rate=24000)

        # ffmpeg 混流（-c:v copy 保留视频轨，-c:a aac 编码音频）
        cmd = [
            "ffmpeg", "-y",
            "-i", temp_video,
            "-i", temp_audio,
            "-c:v", "copy",
            "-c:a", "aac",
            "-shortest",
            "-movflags", "+faststart",
            out_mp4,
        ]
        result = subprocess.run(cmd, capture_output=True)
        if result.returncode != 0:
            logger.error(
                f"[{client_id}] ffmpeg error (seg {segment_id}): {result.stderr.decode()}"
            )
            return None

        with open(out_mp4, "rb") as f:
            return f.read()


# ══════════════════════════════════════════════════════════════════════════════
# 会话管理
# ══════════════════════════════════════════════════════════════════════════════

class FlashHeadSession:
    """
    MP4 分段方案：
    首段使用 FIRST_SEGMENT_CHUNKS，后续使用 STEADY_SEGMENT_CHUNKS 合并为 MP4（包含视频+音频），
    通过 WebSocket 发送给客户端顺序播放，音画天然同步。
    """

    MSG_MP4 = b"\x04"  # [1B type=0x04][4B mp4_len LE][MP4 bytes]

    def __init__(self, client_id: str):
        self.client_id = client_id
        self.ws: Optional[WebSocket] = None

        self._stop_event = asyncio.Event()
        self._inference_task: Optional[asyncio.Task] = None
        self._media_queue: asyncio.Queue = asyncio.Queue(maxsize=50)
        self._send_task: Optional[asyncio.Task] = None
        self._encode_queue: asyncio.Queue = asyncio.Queue(maxsize=20)
        self._encode_task: Optional[asyncio.Task] = None

        # FlashHead 推理参数（__init__ 时从全局获取）
        p = _infer_params
        self.sample_rate: int = int(p["sample_rate"])       # 16000
        self.tgt_fps: int = int(p["tgt_fps"])               # 25
        self.frame_num: int = int(p["frame_num"])           # 33
        self.motion_frames_num: int = int(p["motion_frames_num"])
        self.cached_audio_duration: int = int(p["cached_audio_duration"])

        self.slice_len = self.frame_num - self.motion_frames_num
        self.slice_samples = self.slice_len * self.sample_rate // self.tgt_fps

        cached_len = self.sample_rate * self.cached_audio_duration
        self.audio_dq = deque([0.0] * cached_len, maxlen=cached_len)
        self.audio_end_idx = self.cached_audio_duration * self.tgt_fps
        self.audio_start_idx = self.audio_end_idx - self.frame_num

        self._pending_16k = np.array([], dtype=np.float32)
        self._audio_in_queue: asyncio.Queue = asyncio.Queue()

        # 24kHz 音频缓冲（随 TTS 音频到达而增长，按 chunk 消费）
        # 每个推理 chunk 对应的 24kHz 字节数：
        # samples_per_chunk_24k = slice_len * 24000 / tgt_fps
        # bytes_per_chunk_24k = samples * 2（int16）
        self._audio_bytes_per_chunk: int = self.slice_len * 24000 // self.tgt_fps * 2
        self._audio_24k_buffer = bytearray()

        # MP4 分段缓冲
        self._frame_chunks: List[np.ndarray] = []   # 每个 chunk 的帧（下采样后）
        self._audio_24k_chunks: List[bytes] = []    # 每个 chunk 对应的 24kHz 音频
        self._seg_chunk_count: int = 0
        self._segment_id: int = 0
        self._segment_target_chunks: int = FIRST_SEGMENT_CHUNKS

    # ── WebSocket 发送循环 ──────────────────────────────────────────────────

    async def start_send_loop(self, ws: WebSocket):
        self.ws = ws
        self._send_task = asyncio.create_task(self._send_loop())

    async def _send_loop(self):
        while True:
            try:
                msg = await asyncio.wait_for(self._media_queue.get(), timeout=1.0)
            except asyncio.TimeoutError:
                if self.ws is None:
                    break
                continue
            except asyncio.CancelledError:
                break

            if msg is None:
                break

            if self.ws is None:
                continue
            try:
                await self.ws.send_bytes(msg)
            except Exception as e:
                logger.warning(f"[{self.client_id}] send_bytes error: {e}")
                break

        logger.info(f"[{self.client_id}] Send loop stopped")

    async def _enqueue(self, msg: bytes):
        try:
            self._media_queue.put_nowait(msg)
        except asyncio.QueueFull:
            try:
                self._media_queue.get_nowait()
            except asyncio.QueueEmpty:
                pass
            await self._media_queue.put(msg)

    async def start_encode_loop(self):
        if self._encode_task is None or self._encode_task.done():
            self._encode_task = asyncio.create_task(self._encode_loop())

    async def _encode_loop(self):
        loop = asyncio.get_running_loop()
        while True:
            if self._stop_event.is_set() and self._encode_queue.empty():
                break
            try:
                item = await asyncio.wait_for(self._encode_queue.get(), timeout=1.0)
            except asyncio.TimeoutError:
                continue
            except asyncio.CancelledError:
                break

            if item is None:
                break

            segment_id, frame_chunks, audio_chunks = item
            client_id = self.client_id
            logger.info(
                f"[{client_id}] Encoding segment {segment_id} ({len(frame_chunks)} chunks)..."
            )

            mp4_bytes = await loop.run_in_executor(
                None,
                _encode_segment,
                frame_chunks,
                audio_chunks,
                OUTPUT_FPS,
                client_id,
                segment_id,
            )

            if mp4_bytes and not self._stop_event.is_set():
                msg = self.MSG_MP4 + struct.pack("<I", len(mp4_bytes)) + mp4_bytes
                await self._enqueue(msg)
                logger.info(
                    f"[{client_id}] Segment {segment_id} sent ({len(mp4_bytes) // 1024} KB)"
                )

        logger.info(f"[{self.client_id}] Encode loop stopped")

    def _clear_encode_queue(self):
        while not self._encode_queue.empty():
            try:
                self._encode_queue.get_nowait()
            except asyncio.QueueEmpty:
                break

    # ── 打断 ─────────────────────────────────────────────────────────────────

    def interrupt(self):
        self._stop_event.set()
        # 清空发送队列
        while not self._media_queue.empty():
            try:
                self._media_queue.get_nowait()
            except asyncio.QueueEmpty:
                break
        # 清空推理输入
        self._pending_16k = np.array([], dtype=np.float32)
        self._audio_24k_buffer.clear()
        while not self._audio_in_queue.empty():
            try:
                self._audio_in_queue.get_nowait()
            except asyncio.QueueEmpty:
                break
        # 清空分段缓冲
        self._frame_chunks.clear()
        self._audio_24k_chunks.clear()
        self._seg_chunk_count = 0
        self._segment_id = 0
        self._segment_target_chunks = FIRST_SEGMENT_CHUNKS
        self._clear_encode_queue()
        if self._encode_task and not self._encode_task.done():
            self._encode_task.cancel()
        self._encode_task = None

    def reset_stop(self):
        self._stop_event = asyncio.Event()

    # ── 接收 TTS 音频 ────────────────────────────────────────────────────────

    async def push_tts_audio(self, pcm_int16_24k: bytes):
        """
        接收 TTS 输出的 int16 PCM（24kHz）：
          1. 存入 24kHz 缓冲，等待与推理帧按 chunk 捆绑
          2. 降采样到 16kHz float32 → 推入推理队列
        """
        if not pcm_int16_24k:
            return
        self._audio_24k_buffer.extend(pcm_int16_24k)

        arr_int16 = np.frombuffer(pcm_int16_24k, dtype=np.int16)
        arr_f32 = arr_int16.astype(np.float32) / 32768.0
        arr_16k = soxr.resample(arr_f32, 24000, 16000)
        await self._audio_in_queue.put(arr_16k)

    async def flush_tts(self):
        """TTS 结束，通知推理循环刷新剩余帧为最后一段 MP4。"""
        await self._audio_in_queue.put(_FLUSH_SENTINEL)

    # ── MP4 分段编码与发送 ───────────────────────────────────────────────────

    async def _do_flush_segment(self):
        """将当前缓冲的 chunk 编码为 MP4 并发送。"""
        if not self._frame_chunks or self._stop_event.is_set():
            self._frame_chunks.clear()
            self._audio_24k_chunks.clear()
            self._seg_chunk_count = 0
            return

        frame_chunks = list(self._frame_chunks)
        audio_chunks = list(self._audio_24k_chunks)
        segment_id = self._segment_id

        # 立即清空缓冲，不等待编码完成
        self._frame_chunks.clear()
        self._audio_24k_chunks.clear()
        self._seg_chunk_count = 0
        self._segment_id += 1
        if self._segment_target_chunks != STEADY_SEGMENT_CHUNKS:
            self._segment_target_chunks = STEADY_SEGMENT_CHUNKS

        try:
            self._encode_queue.put_nowait((segment_id, frame_chunks, audio_chunks))
        except asyncio.QueueFull:
            logger.warning(f"[{self.client_id}] Encode queue full, dropping oldest segment")
            try:
                self._encode_queue.get_nowait()
            except asyncio.QueueEmpty:
                pass
            await self._encode_queue.put((segment_id, frame_chunks, audio_chunks))

    async def _process_ready_chunks(
        self,
        loop: asyncio.AbstractEventLoop,
        executor: concurrent.futures.ThreadPoolExecutor,
    ):
        """处理 _pending_16k 中可推理的完整 chunk。"""
        while (
            len(self._pending_16k) >= self.slice_samples
            and not self._stop_event.is_set()
        ):
            audio_slice = self._pending_16k[: self.slice_samples]
            self._pending_16k = self._pending_16k[self.slice_samples :]

            self.audio_dq.extend(audio_slice.tolist())
            audio_array = np.array(self.audio_dq, dtype=np.float32)

            try:
                async with _inference_lock:
                    audio_embedding = await loop.run_in_executor(
                        executor,
                        get_audio_embedding,
                        _pipeline,
                        audio_array,
                        self.audio_start_idx,
                        self.audio_end_idx,
                    )
                    frames = await loop.run_in_executor(
                        executor,
                        run_pipeline,
                        _pipeline,
                        audio_embedding,
                    )

                frames = frames[self.motion_frames_num :]
                frames_np = frames.cpu().numpy().astype(np.uint8)

                # 下采样到 OUTPUT_FPS（保持视频时长不变）
                frames_np = _subsample_frames(frames_np, self.tgt_fps, OUTPUT_FPS)
                # 可选缩分辨率（降低编码与解码压力）
                frames_np = _downscale_frames(frames_np, OUTPUT_MAX_EDGE)

                self._frame_chunks.append(frames_np)

                # 取对应的 24kHz 音频（1 个 chunk 的量）
                abpc = self._audio_bytes_per_chunk
                if len(self._audio_24k_buffer) >= abpc:
                    audio_chunk_24k = bytes(self._audio_24k_buffer[:abpc])
                    del self._audio_24k_buffer[:abpc]
                else:
                    # 缓冲不足时用静音填充
                    audio_chunk_24k = (
                        bytes(self._audio_24k_buffer)
                        + bytes(abpc - len(self._audio_24k_buffer))
                    )
                    self._audio_24k_buffer.clear()
                self._audio_24k_chunks.append(audio_chunk_24k)

                self._seg_chunk_count += 1

                # 首段短、后续长：降低首帧时延并减少段切换频率
                if self._seg_chunk_count >= self._segment_target_chunks:
                    await self._do_flush_segment()

            except Exception as e:
                logger.error(
                    f"[{self.client_id}] Inference error: {e}", exc_info=True
                )

    # ── 推理循环 ─────────────────────────────────────────────────────────────

    async def start_inference_loop(self):
        await self.start_encode_loop()
        self._inference_task = asyncio.create_task(self._inference_loop())

    async def _inference_loop(self):
        loop = asyncio.get_running_loop()
        executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)

        logger.info(f"[{self.client_id}] Inference loop started")

        while not self._stop_event.is_set():
            try:
                chunk = await asyncio.wait_for(
                    self._audio_in_queue.get(), timeout=1.0
                )
            except asyncio.TimeoutError:
                continue
            except asyncio.CancelledError:
                break

            # flush 哨兵：TTS 已结束，刷新剩余 chunk
            if chunk is _FLUSH_SENTINEL:
                # 对齐 gradio_app_streaming.py：尾音频补零到完整 chunk 再推理
                # 避免最后不足一个 chunk 的音频被直接丢弃。
                if 0 < len(self._pending_16k) < self.slice_samples:
                    pad_len = self.slice_samples - len(self._pending_16k)
                    self._pending_16k = np.concatenate(
                        [self._pending_16k, np.zeros(pad_len, dtype=np.float32)]
                    )

                await self._process_ready_chunks(loop, executor)
                await self._do_flush_segment()
                continue

            self._pending_16k = np.concatenate([self._pending_16k, chunk])
            await self._process_ready_chunks(loop, executor)

        logger.info(f"[{self.client_id}] Inference loop stopped")

    # ── 关闭 ─────────────────────────────────────────────────────────────────

    async def close(self):
        self._stop_event.set()
        if self._inference_task and not self._inference_task.done():
            self._inference_task.cancel()
            try:
                await self._inference_task
            except asyncio.CancelledError:
                pass
        if self._send_task and not self._send_task.done():
            try:
                self._media_queue.put_nowait(None)
            except asyncio.QueueFull:
                pass
            self._send_task.cancel()
            try:
                await self._send_task
            except asyncio.CancelledError:
                pass
        if self._encode_task and not self._encode_task.done():
            try:
                self._encode_queue.put_nowait(None)
            except asyncio.QueueFull:
                pass
            self._encode_task.cancel()
            try:
                await self._encode_task
            except asyncio.CancelledError:
                pass
        logger.info(f"[{self.client_id}] Session closed")


_sessions: Dict[str, FlashHeadSession] = {}


# ══════════════════════════════════════════════════════════════════════════════
# FastAPI 应用
# ══════════════════════════════════════════════════════════════════════════════

def create_app(cfg: ServerConfig) -> FastAPI:
    global _cfg
    _cfg = cfg

    @asynccontextmanager
    async def lifespan(app: FastAPI):
        global _pipeline, _infer_params, _inference_lock
        _inference_lock = asyncio.Lock()

        logger.info("[FlashHead] Loading model, please wait...")
        device = cfg.device
        os.environ.setdefault("CUDA_VISIBLE_DEVICES", device.replace("cuda:", ""))

        _pipeline = get_pipeline(
            world_size=1,
            ckpt_dir=cfg.ckpt_dir,
            wav2vec_dir=cfg.wav2vec_dir,
            model_type=cfg.model_type,
        )
        get_base_data(
            _pipeline,
            cond_image_path_or_dir=cfg.cond_image,
            base_seed=cfg.base_seed,
            use_face_crop=cfg.use_face_crop,
        )
        _infer_params = get_infer_params()
        logger.info(
            f"[FlashHead] Model loaded. sr={_infer_params['sample_rate']}, "
            f"fps={_infer_params['tgt_fps']}, frame_num={_infer_params['frame_num']}"
        )
        logger.info(
            "[FlashHead] Stream config: "
            f"out_fps={OUTPUT_FPS}, first_seg={FIRST_SEGMENT_CHUNKS}, "
            f"steady_seg={STEADY_SEGMENT_CHUNKS}, max_edge={OUTPUT_MAX_EDGE}, "
            f"preset={ENCODE_PRESET}, crf={ENCODE_CRF}"
        )

        # 预热推理（触发 torch.compile，消除用户首次 ~30s 等待）
        logger.info("[FlashHead] Warming up model (torch.compile, may take ~30s)...")
        _wp = _infer_params
        _wp_sr = int(_wp["sample_rate"])
        _wp_dur = int(_wp["cached_audio_duration"])
        _wp_fn = int(_wp["frame_num"])
        _wp_fps = int(_wp["tgt_fps"])
        _wp_end = _wp_dur * _wp_fps
        _wp_start = _wp_end - _wp_fn
        _dummy = np.zeros(_wp_sr * _wp_dur, dtype=np.float32)
        _wl = asyncio.get_running_loop()
        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as _ex:
            _emb = await _wl.run_in_executor(
                _ex, get_audio_embedding, _pipeline, _dummy, _wp_start, _wp_end
            )
            await _wl.run_in_executor(_ex, run_pipeline, _pipeline, _emb)
        logger.info("[FlashHead] Warm-up complete. Ready to serve.")
        yield

        for session in list(_sessions.values()):
            await session.close()
        _sessions.clear()

    app = FastAPI(lifespan=lifespan)

    @app.get("/health")
    async def health():
        return {"status": "ok", "sessions": len(_sessions)}

    @app.websocket("/ws/{client_id}")
    async def ws_stream(websocket: WebSocket, client_id: str):
        await websocket.accept()
        logger.info(f"[{client_id}] WebSocket connected")

        session = _sessions.get(client_id)
        if session is None:
            session = FlashHeadSession(client_id)
            _sessions[client_id] = session

        await session.start_send_loop(websocket)

        try:
            while True:
                await websocket.receive_text()
        except (WebSocketDisconnect, Exception) as e:
            logger.info(f"[{client_id}] WebSocket disconnected: {e}")
        finally:
            session.ws = None
            logger.info(f"[{client_id}] WebSocket closed")

    @app.post("/push_audio/{client_id}")
    async def push_audio(client_id: str, request: Request):
        if client_id not in _sessions:
            _sessions[client_id] = FlashHeadSession(client_id)

        session = _sessions[client_id]

        if session._inference_task is None or session._inference_task.done():
            while not session._audio_in_queue.empty():
                try:
                    session._audio_in_queue.get_nowait()
                except asyncio.QueueEmpty:
                    break
            session._pending_16k = np.array([], dtype=np.float32)
            session._audio_24k_buffer.clear()
            session._frame_chunks.clear()
            session._audio_24k_chunks.clear()
            session._seg_chunk_count = 0
            session._segment_id = 0
            session._segment_target_chunks = FIRST_SEGMENT_CHUNKS
            session.reset_stop()
            await session.start_inference_loop()

        pcm_bytes = await request.body()
        await session.push_tts_audio(pcm_bytes)
        return JSONResponse({"ok": True})

    @app.post("/flush/{client_id}")
    async def flush_audio(client_id: str):
        """TTS 音频发送完毕，通知推理循环刷新剩余帧。"""
        session = _sessions.get(client_id)
        if session:
            await session.flush_tts()
        return JSONResponse({"ok": True})

    @app.post("/interrupt/{client_id}")
    async def interrupt(client_id: str):
        session = _sessions.get(client_id)
        if session:
            session.interrupt()
        return JSONResponse({"ok": True})

    return app
